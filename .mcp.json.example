{
  "mcpServers": {
    "chrome": {
      "command": "node",
      "args": ["/absolute/path/to/chrome-mcp/src/server.js"],
      "env": {
        "CHROME_PATH": "/usr/bin/google-chrome-stable",
        "CHROME_DEFAULT_PROFILE_DIR": "/absolute/path/to/chrome-mcp-profile",
        "CHROME_PROFILES_DIR": "/absolute/path/to/chrome-mcp-profiles",
        "DISPLAY": ":99"
      }
    }
  }
}
